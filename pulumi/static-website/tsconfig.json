{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2025"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2025",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
